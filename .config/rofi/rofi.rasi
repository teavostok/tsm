
* {
    /* ── Depth layers ─────────────────────────────────── */
    /* Abyss: the deepest water, used for the main window body */
    col-abyss:          rgba(96, 96, 96, 0.16);
    /* Depth: mid-water panels — inputbar, message box, rows */
    col-depth:          rgba(84, 84, 84, 0.4);
    /* Shallows: hover shimmer on list rows */
    col-shallows:       rgba(255, 255, 255, 0.4);
    /* Crest: the saturated highlight / selected state */
    col-crest:          rgba(255, 255, 255, 0.2);

    /* ── Glass layer (the frosted pane) ───────────────── */
    col-glass:          rgba(200, 215, 230,  0.08);
    col-glass-heavy:    rgba(200, 215, 230, 0.14);

    /* ── Border / glow family ─────────────────────────── */
    col-rim:            rgba(150, 180, 210,  0.25);
    col-rim-hot:        rgba(227, 227, 227, 0.6);
    col-rim-faint:      rgba(150, 180, 210,  0.12);

    /* ── Text ─────────────────────────────────────────── */
    col-snow:           rgba(235, 248, 255,  0.65);    /* primary text */
    col-mist:           rgba(223, 223, 223, 0.4);    /* secondary / placeholder */
    col-foam:           rgba(100, 195, 255,  1.00);    /* accent label / prompt */
    col-granite:        rgba(255, 255, 255, 0.35);    /* disabled / faint */

    /* ── Urgency / active accent ──────────────────────── */
    col-ember:          rgba(255, 130,  80,  0.85);
    col-ember-bg:       rgba(255,  80,  50,  0.18);

    /* ── Semantic defaults (rofi reads these) ─────────── */
    background-color:   transparent;
    text-color:         @col-snow;
    font:               "Hack 12";
    /*
     * Font fallback chain — uncomment your preference:
     *   "JetBrains Mono 12"  |  "FiraCode Nerd Font 12"
     *   "Hack 12"            |  "monospace 12"
     */
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   WINDOW
   The outermost container. transparency:"real" asks rofi to
   composite against the wallpaper/compositor blur layer.
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
window {
    transparency:       "real";
    background-color:   @col-abyss;
    border-color:       @col-rim;
    border:             1px solid;
    border-radius:      10px;
    padding:            0px;
    width:              540px;
    location:           center;
    anchor:             center;
    x-offset:           0px;
    y-offset:           -60px;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   MAIN BOX — vertical stack inside the window
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
mainbox {
    background-color:   transparent;
    border:             0px;
    padding:            18px;
    spacing:            12px;
    children:           [ inputbar, message, listview, mode-switcher ];
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   INPUT BAR — the glassy search well at the top
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
inputbar {
    background-color:   @col-depth;
    border-color:       @col-rim;
    border:             1px solid;
    border-radius:      12px;
    padding:            11px 16px;
    spacing:            10px;
    text-color:         @col-snow;
    children:           [ prompt, textbox-prompt-colon, entry, case-indicator, num-filtered-rows, textbox-num-sep, num-rows ];
}

prompt {
    background-color:   transparent;
    text-color:         @col-foam;
    font:               "Mono";
    /* Change to any Nerd Font icon glyph as your prompt symbol:
       e.g. set prompt to "󰍉 " in your rofi call  */
}

textbox-prompt-colon {
    background-color:   transparent;
    text-color:         @col-granite;
    str:                " ";
}

entry {
    background-color:   transparent;
    text-color:         @col-snow;
    placeholder:        "Search";
    placeholder-color:  @col-mist;
    cursor:             text;
    blink:              true;
}

case-indicator {
    background-color:   transparent;
    text-color:         @col-granite;
}

/* row count — shown faintly at the right of the search bar */
num-filtered-rows {
    background-color:   transparent;
    text-color:         @col-granite;
    expand:             false;
}

textbox-num-sep {
    background-color:   transparent;
    text-color:         @col-granite;
    str:                "/";
    expand:             false;
}

num-rows {
    background-color:   transparent;
    text-color:         @col-granite;
    expand:             false;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   MESSAGE / ERROR BOX
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
message {
    background-color:   @col-glass-heavy;
    border-color:       @col-rim-faint;
    border:             1px solid;
    border-radius:      7px;
    padding:            8px 14px;
}

textbox {
    background-color:   transparent;
    text-color:         @col-mist;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

error-message {
    background-color:   @col-ember-bg;
    border-color:       @col-ember;
    border:             1px solid;
    border-radius:      7px;
    padding:            8px 14px;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   LIST VIEW — the results scroll area
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
listview {
    background-color:   transparent;
    border:             0px;
    padding:            2px 0px;
    spacing:            4px;
    lines:              8;
    columns:            1;
    fixed-height:       false;
    cycle:              true;
    scrollbar:          true;
    scrollbar-width:    4px;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   SCROLLBAR — thin glowing track on the right
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
scrollbar {
    background-color:   @col-glass;
    handle-color:       @col-crest;
    handle-width:       4px;
    border:             0px;
    border-radius:      12px;
    padding:            0px 2px;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   ELEMENT — individual result rows
   Row state names follow rofi's convention:
     normal   = idle row
     alternate = every other idle row (subtle zebra stripe)
     selected = keyboard/mouse focused row
   Combined with type:
     .normal  = default
     .urgent  = flagged urgent
     .active  = flagged active
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

/* base element container */
element {
    background-color:   transparent;
    border-radius:      7px;
    padding:            8px 14px;
    spacing:            10px;
    orientation:        horizontal;
}

/* ── normal rows ───────────────────────────────────────── */
element normal.normal {
    background-color:   transparent;
    text-color:         @col-mist;
    border-color:       transparent;
}

element normal.urgent {
    background-color:   @col-ember-bg;
    text-color:         @col-ember;
    border-color:       transparent;
}

element normal.active {
    background-color:   @col-shallows;
    text-color:         @col-snow;
    border-color:       @col-rim-faint;
}

/* ── alternate (zebra) rows ───────────────────────────── */
element alternate.normal {
    background-color:   @col-glass;
    text-color:         @col-mist;
    border-color:       transparent;
}

element alternate.urgent {
    background-color:   @col-ember-bg;
    text-color:         @col-ember;
    border-color:       transparent;
}

element alternate.active {
    background-color:   @col-shallows;
    text-color:         @col-snow;
    border-color:       @col-rim-faint;
}

/* ── selected rows ────────────────────────────────────── */
element selected.normal {
    background-color:   @col-crest;
    border-color:       @col-rim-hot;
    text-color:         @col-snow;
}

element selected.urgent {
    background-color:   rgba(255, 80, 50, 0.50);
    border-color:       @col-ember;
    text-color:         @col-snow;
}

element selected.active {
    background-color:   @col-crest;
    border-color:       @col-rim-hot;
    text-color:         @col-snow;
}

/* ── icon inside each row ─────────────────────────────── */
element-icon {
    background-color:   transparent;
    size:               24px;
    margin:             0px 2px 0px 0px;
    vertical-align:     0.5;
}

/* ── label text inside each row ──────────────────────── */
element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
    /* matched characters light up in Tahoe foam blue */
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   MODE SWITCHER — drun / run / window / ssh tabs
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
mode-switcher {
    background-color:   transparent;
    border:             0px;
    spacing:            6px;
}

button {
    background-color:   @col-glass;
    text-color:         @col-mist;
    border-radius:      6px;
    padding:            5px 13px;
    cursor:             pointer;
}

button selected {
    background-color:   @col-shallows;
    border-color:       @col-rim;
    text-color:         @col-snow;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   SIDEBAR (used in some rofi modes like file-browser)
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
sidebar {
    background-color:   @col-glass;
    border-color:       @col-rim-faint;
    border:             0px 0px 0px 1px solid;
    border-radius:      0px 0px 0px 10px;
    padding:            10px;
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   OVERLAY (background dimming layer)
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
overlay {
    background-color:   rgba(4, 10, 24, 0.50);
}

/* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
   PICOM CONFIGURATION REFERENCE
   For true frosted glass, add this to ~/.config/picom.conf:

   blur-method = "dual_kawase";
   blur-strength = 8;
   blur-background = true;
   blur-background-frame = true;
   blur-background-fixed = true;

   # Target the rofi window specifically:
   blur-background-exclude = [
     "class_g = 'slop'",
     "class_g = 'zoom'"
   ];

   # Make sure rofi itself is marked as transparent:
   opacity-rule = [
     "90:class_g = 'Rofi'"
   ];
   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
