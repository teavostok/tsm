* {
    col-abyss:          rgba(96, 96, 96, 0.22);
    col-depth:          rgba(84, 84, 84, 0.3);
    col-shallows:       rgba(255, 255, 255, 0.3);
    col-crest:          rgba(255, 255, 255, 0.2);
    col-glass:          rgba(200, 215, 230, 0.08);
    col-glass-heavy:    rgba(200, 215, 230, 0.15);
    col-rim:            rgba(150, 180, 210, 0.25);
    col-rim-hot:        rgba(120, 160, 210, 0.60);
    col-rim-faint:      rgba(150, 180, 210, 0.12);
    col-snow:           rgba(235, 248, 255, 0.95);
    col-mist:           rgba(223, 223, 223, 0.7);
    col-foam:           rgba(100, 195, 255, 1.00);
    col-granite:        rgba(255, 255, 255, 0.35);
    col-ember:          rgba(255, 130, 80, 0.85);
    col-ember-bg:       rgba(255, 80, 50, 0.18);
    background-color:   transparent;
    text-color:         @col-snow;
    font:               "SF Pro Display 12";
}

window {
    transparency:       "real";
    background-color:   @col-abyss;
    border-color:       @col-rim;
    border:             1px solid;
    border-radius:      10px;
    padding:            0px;
    width:              540px;
    location:           center;
    anchor:             center;
    x-offset:           0px;
    y-offset:           -60px;
}

mainbox {
    background-color:   transparent;
    border:             0px;
    padding:            18px;
    spacing:            12px;
    children:           [ inputbar, message, listview, mode-switcher ];
}

inputbar {
    background-color:   @col-depth;
    border-color:       @col-rim;
    border:             1px solid;
    border-radius:      7px;
    padding:            11px 16px;
    spacing:            10px;
    text-color:         @col-snow;
    children:           [ prompt, textbox-prompt-colon, entry, case-indicator, num-filtered-rows, textbox-num-sep, num-rows ];
}

prompt {
    background-color:   transparent;
    text-color:         @col-foam;
    font:               "SF Pro Display Bold 12";
}

textbox-prompt-colon {
    background-color:   transparent;
    text-color:         @col-granite;
    str:                " ";
}

entry {
    background-color:   transparent;
    text-color:         @col-snow;
    placeholder:        "Search";
    placeholder-color:  @col-mist;
    cursor:             text;
    blink:              true;
}

case-indicator {
    background-color:   transparent;
    text-color:         @col-granite;
}

num-filtered-rows {
    background-color:   transparent;
    text-color:         @col-granite;
    expand:             false;
}

textbox-num-sep {
    background-color:   transparent;
    text-color:         @col-granite;
    str:                "/";
    expand:             false;
}

num-rows {
    background-color:   transparent;
    text-color:         @col-granite;
    expand:             false;
}

message {
    background-color:   @col-glass-heavy;
    border-color:       @col-rim-faint;
    border:             1px solid;
    border-radius:      5px;
    padding:            8px 14px;
}

textbox {
    background-color:   transparent;
    text-color:         @col-mist;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

error-message {
    background-color:   @col-ember-bg;
    border-color:       @col-ember;
    border:             1px solid;
    border-radius:      5px;
    padding:            8px 14px;
}

listview {
    background-color:   transparent;
    border:             0px;
    padding:            2px 0px;
    spacing:            4px;
    lines:              8;
    columns:            1;
    fixed-height:       false;
    cycle:              true;
    scrollbar:          true;
    scrollbar-width:    4px;
}

scrollbar {
    background-color:   @col-glass;
    handle-color:       @col-crest;
    handle-width:       4px;
    border:             0px;
    border-radius:      2px;
    padding:            0px 2px;
}

element {
    background-color:   transparent;
    border-radius:      5px;
    padding:            8px 14px;
    spacing:            10px;
    orientation:        horizontal;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @col-mist;
    border-color:       transparent;
}

element normal.urgent {
    background-color:   @col-ember-bg;
    text-color:         @col-ember;
    border-color:       transparent;
}

element normal.active {
    background-color:   @col-shallows;
    text-color:         @col-snow;
    border-color:       @col-rim-faint;
}

element alternate.normal {
    background-color:   @col-glass;
    text-color:         @col-mist;
    border-color:       transparent;
}

element alternate.urgent {
    background-color:   @col-ember-bg;
    text-color:         @col-ember;
    border-color:       transparent;
}

element alternate.active {
    background-color:   @col-shallows;
    text-color:         @col-snow;
    border-color:       @col-rim-faint;
}

element selected.normal {
    background-color:   @col-crest;
    border-color:       @col-rim-hot;
    text-color:         @col-snow;
}

element selected.urgent {
    background-color:   rgba(255, 80, 50, 0.50);
    border-color:       @col-ember;
    text-color:         @col-snow;
}

element selected.active {
    background-color:   @col-crest;
    border-color:       @col-rim-hot;
    text-color:         @col-snow;
}

element-icon {
    background-color:   transparent;
    size:               24px;
    margin:             0px 2px 0px 0px;
    vertical-align:     0.5;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}

mode-switcher {
    background-color:   transparent;
    border:             0px;
    spacing:            6px;
}

button {
    background-color:   @col-glass;
    text-color:         @col-mist;
    border-radius:      5px;
    padding:            5px 13px;
    cursor:             pointer;
}

button selected {
    background-color:   @col-shallows;
    border-color:       @col-rim;
    text-color:         @col-snow;
}

sidebar {
    background-color:   @col-glass;
    border-color:       @col-rim-faint;
    border:             0px 0px 0px 1px solid;
    border-radius:      0px 0px 0px 8px;
    padding:            10px;
}

overlay {
    background-color:   rgba(4, 10, 24, 0.50);
}
